<!DOCTYPE html>
<html lang="en">
<head>
	<link rel="shortcut icon" type="png" href="/images/image Education logo.png">
	<meta charset="utf-8">
	<title>User Dashboard | Growth Guide</title>
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="stylesheet" type="text/css" href="/css/style.css">
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
	
	<style>
		:root {
			--dash-bg: #f8fafc;
			--dash-surface: rgba(255, 255, 255, 0.8);
			--dash-border: rgba(255, 255, 255, 0.5);
			--dash-text: #0f172a;
			--dash-text-muted: #64748b;
			--primary: #8b5cf6;
			--secondary: #ec4899;
		}

		body.dark {
			--dash-bg: #0f172a;
			--dash-surface: rgba(30, 41, 59, 0.7);
			--dash-border: rgba(255, 255, 255, 0.05);
			--dash-text: #f8fafc;
			--dash-text-muted: #94a3b8;
		}

		body {
			background: var(--dash-bg);
			background-image: 
				radial-gradient(at 0% 0%, rgba(139, 92, 246, 0.15) 0px, transparent 50%),
				radial-gradient(at 100% 0%, rgba(236, 72, 153, 0.15) 0px, transparent 50%);
			background-attachment: fixed;
			font-family: 'Inter', sans-serif;
			color: var(--dash-text);
			transition: background 0.5s ease, color 0.5s ease;
			min-height: 100vh;
		}

		/* Top Navigation Override */
		nav {
			background: var(--dash-surface) !important;
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			border-bottom: 1px solid var(--dash-border);
			box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
		}

		.dashboard-container {
			max-width: 1400px;
			margin: 100px auto 50px auto;
			padding: 0 5%;
			display: grid;
			grid-template-columns: 1fr 380px;
			gap: 40px;
		}

		@media (max-width: 1024px) {
			.dashboard-container {
				grid-template-columns: 1fr;
			}
		}

		/* Glassmorphism Card Utility */
		.glass-card {
			background: var(--dash-surface);
			backdrop-filter: blur(16px);
			-webkit-backdrop-filter: blur(16px);
			border: 1px solid var(--dash-border);
			border-radius: 24px;
			box-shadow: 0 10px 40px -10px rgba(0,0,0,0.08);
			overflow: hidden;
			transition: transform 0.3s ease, box-shadow 0.3s ease;
		}

		/* Animations */
		@keyframes fadeUp {
			from { opacity: 0; transform: translateY(30px); }
			to { opacity: 1; transform: translateY(0); }
		}

		.animate-in {
			animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
			opacity: 0;
		}
		.delay-1 { animation-delay: 0.1s; }
		.delay-2 { animation-delay: 0.2s; }
		.delay-3 { animation-delay: 0.3s; }

		/* Left Column: Hero Banner */
		.welcome-banner {
			padding: 40px;
			background: linear-gradient(135deg, rgba(139,92,246,0.1), rgba(236,72,153,0.1));
			border: 1px solid var(--dash-border);
			position: relative;
		}
		
		.gradient-text {
			background: linear-gradient(135deg, var(--primary), var(--secondary));
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		/* Stats Grid */
		.stats-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
			gap: 20px;
			margin-top: 30px;
		}
		.stat-item {
			padding: 20px;
			background: var(--dash-surface);
			border-radius: 16px;
			border: 1px solid var(--dash-border);
			text-align: center;
		}

		/* Course Cards */
		.course-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
			gap: 25px;
			margin-top: 20px;
		}
		.course-card {
			padding: 25px;
			display: flex;
			flex-direction: column;
		}
		.course-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 20px 40px -10px rgba(139, 92, 246, 0.15);
		}
		.progress-bg {
			width: 100%;
			height: 8px;
			background: rgba(100,116,139,0.2);
			border-radius: 4px;
			margin: 15px 0;
			overflow: hidden;
		}
		.progress-fill {
			height: 100%;
			border-radius: 4px;
			transition: width 1s ease-in-out;
		}

		/* Right Column: Profile Sidebar */
		.profile-sidebar {
			display: flex;
			flex-direction: column;
			gap: 30px;
		}
		.profile-card {
			padding: 40px 30px;
			text-align: center;
			display: flex;
			flex-direction: column;
			align-items: center;
		}
		.avatar-wrapper {
			width: 140px;
			height: 140px;
			border-radius: 50%;
			padding: 4px;
			background: linear-gradient(135deg, var(--primary), var(--secondary));
			margin-bottom: 20px;
		}
		.avatar-wrapper img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			border-radius: 50%;
			border: 4px solid var(--dash-bg);
		}
		.btn-outline {
			margin-top: 20px;
			padding: 10px 24px;
			border: 1px solid var(--primary);
			color: var(--primary);
			border-radius: 30px;
			font-weight: 600;
			text-decoration: none;
			transition: all 0.2s;
		}
		.btn-outline:hover {
			background: var(--primary);
			color: white;
		}

		/* Activity List */
		.activity-list {
			list-style: none;
			padding: 0;
			margin-top: 20px;
		}
		.activity-item {
			display: flex;
			align-items: center;
			gap: 15px;
			padding: 15px 0;
			border-bottom: 1px solid var(--dash-border);
		}
		.activity-item:last-child { border-bottom: none; }
		.activity-icon {
			width: 40px;
			height: 40px;
			border-radius: 12px;
			background: rgba(139, 92, 246, 0.1);
			color: var(--primary);
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 20px;
		}
	</style>

	<script>
		function toggleDark() {
			document.body.classList.toggle('dark');
			const btn = document.querySelector('.dark-toggle');
			btn.textContent = document.body.classList.contains('dark') ? '☀️' : '🌙';
			localStorage.setItem('darkMode', document.body.classList.contains('dark'));
		}
		if (localStorage.getItem('darkMode') === 'true') {
			document.body.classList.add('dark');
			document.addEventListener("DOMContentLoaded", () => {
				document.querySelector('.dark-toggle').textContent = '☀️';
			});
		}
		function toggleProfile() {
			const box = document.getElementById("profileBox");
			box.style.display = box.style.display === "block" ? "none" : "block";
		}
	</script>
</head>
<body>

	<!-- Top Navigation -->
	<header id="header" style="height: auto;">
		<nav>
			<div class="logo"><a href="/"><img src="/images/image Education logo.png" alt="logo" style="height: 40px;"></a></div>
			<ul>
				<li><a href="/">Home</a></li>
				<li><a class="active" href="/dashboard" style="color: var(--primary); font-weight: 600;">Dashboard</a></li>
				<li><a href="/computer_courses">Courses</a></li>
			</ul>
			
			<div class="profile" style="position: relative;">
				<div onclick="toggleProfile()" style="display: flex; align-items: center; gap: 10px; cursor: pointer; padding: 5px 15px; border-radius: 30px; background: rgba(139,92,246,0.1);">
					<span style="font-weight: 600; color: var(--dash-text);"><%= user.username %></span>
					<div style="width: 30px; height: 30px; border-radius: 50%; overflow: hidden;">
						<% if (user.profilePicture) { %>
							<img src="<%= user.profilePicture %>" style="width: 100%; height: 100%; object-fit: cover;">
						<% } else { %>
							<img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.username) %>&background=8b5cf6&color=fff" style="width: 100%; height: 100%;">
						<% } %>
					</div>
				</div>
				<div id="profileBox" class="profile-box" style="display:none; position:absolute; right:0; top: 50px; background: var(--dash-surface); backdrop-filter: blur(10px); border: 1px solid var(--dash-border); padding:20px; border-radius:16px; box-shadow:0 10px 25px rgba(0,0,0,0.1); width: 250px; z-index: 100;">
					<p style="color: var(--dash-text); margin-bottom: 5px;"><b><%= user.username %></b></p>
					<p style="color: var(--dash-text-muted); font-size: 13px; margin-bottom: 15px;"><%= user.email %></p>
					<hr style="border: none; border-top: 1px solid var(--dash-border); margin-bottom: 15px;">
					<a href="/logout" style="display: block; text-align: center; color: #ef4444; text-decoration: none; font-weight: 600; padding: 10px; background: rgba(239, 68, 68, 0.1); border-radius: 8px;">Log Out</a>
				</div>
			</div>

			<button class="dark-toggle" onclick="toggleDark()" title="Toggle Dark Mode" style="border: none; background: rgba(139,92,246,0.1); border-radius: 50%; width: 40px; height: 40px; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center;">🌙</button>
		</nav>
	</header>

	<!-- Main Dashboard Layout -->
	<div class="dashboard-container">
		
		<!-- Left Column: Main Content -->
		<main>
			<!-- Welcome Banner -->
			<div class="glass-card welcome-banner animate-in">
				<h1 style="font-size: 36px; font-weight: 700; margin-bottom: 10px;">
					Welcome back, <span class="gradient-text"><%= user.username %></span>
				</h1>
				<p style="font-size: 16px; color: var(--dash-text-muted);">Your learning journey is looking great. Keep up the momentum!</p>
				
				<div class="stats-grid">
					<div class="stat-item">
						<div class="gradient-text" style="font-size: 36px; font-weight: 700;">3</div>
						<div style="font-size: 13px; color: var(--dash-text-muted); font-weight: 600; text-transform: uppercase; margin-top: 5px;">Active Courses</div>
					</div>
					<div class="stat-item">
						<div class="gradient-text" style="font-size: 36px; font-weight: 700;">12</div>
						<div style="font-size: 13px; color: var(--dash-text-muted); font-weight: 600; text-transform: uppercase; margin-top: 5px;">Quizzes Done</div>
					</div>
					<div class="stat-item">
						<div class="gradient-text" style="font-size: 36px; font-weight: 700;">45h</div>
						<div style="font-size: 13px; color: var(--dash-text-muted); font-weight: 600; text-transform: uppercase; margin-top: 5px;">Time Learned</div>
					</div>
				</div>
			</div>

			<!-- Enrolled Courses -->
			<div class="animate-in delay-1" style="margin-top: 50px;">
				<h2 style="font-size: 22px; font-weight: 700; margin-bottom: 20px;">Continue Learning</h2>
				
				<div class="course-grid">
					<!-- Course 1 -->
					<div class="glass-card course-card">
						<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
							<div style="width: 50px; height: 50px; background: rgba(139,92,246,0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px;">💻</div>
							<span style="padding: 4px 12px; background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 20px; font-size: 12px; font-weight: 600;">In Progress</span>
						</div>
						<h3 style="font-size: 18px; font-weight: 600; margin-bottom: 5px;">Data Structures & Algorithms</h3>
						<p style="font-size: 14px; color: var(--dash-text-muted);">Module 4: Trees and Graphs</p>
						
						<div class="progress-bg">
							<div class="progress-fill" style="width: 65%; background: var(--primary);"></div>
						</div>
						<div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--dash-text-muted); font-weight: 600;">
							<span>65% Completed</span>
							<span>12 / 18 Lessons</span>
						</div>
						
						<a href="/computer_courses#data" style="margin-top: 20px; padding: 12px; background: var(--primary); color: white; text-align: center; border-radius: 8px; text-decoration: none; font-weight: 600; transition: background 0.2s;">Resume Course</a>
					</div>

					<!-- Course 2 -->
					<div class="glass-card course-card">
						<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
							<div style="width: 50px; height: 50px; background: rgba(236,72,153,0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px;">🌐</div>
							<span style="padding: 4px 12px; background: rgba(16, 185, 129, 0.1); color: #10b981; border-radius: 20px; font-size: 12px; font-weight: 600;">In Progress</span>
						</div>
						<h3 style="font-size: 18px; font-weight: 600; margin-bottom: 5px;">Web Development Bootcamp</h3>
						<p style="font-size: 14px; color: var(--dash-text-muted);">Module 2: Advanced CSS</p>
						
						<div class="progress-bg">
							<div class="progress-fill" style="width: 25%; background: var(--secondary);"></div>
						</div>
						<div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--dash-text-muted); font-weight: 600;">
							<span>25% Completed</span>
							<span>4 / 16 Lessons</span>
						</div>
						
						<a href="/computer_courses" style="margin-top: 20px; padding: 12px; background: rgba(236,72,153,0.1); color: var(--secondary); text-align: center; border-radius: 8px; text-decoration: none; font-weight: 600; transition: background 0.2s;">Resume Course</a>
					</div>
				</div>
			</div>
		</main>

		<!-- Right Column: Sidebar -->
		<aside class="profile-sidebar">
			
			<!-- Profile Card -->
			<div class="glass-card profile-card animate-in delay-2">
				<div class="avatar-wrapper">
					<% if (user.profilePicture) { %>
						<img src="<%= user.profilePicture %>" alt="Profile">
					<% } else { %>
						<img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.username) %>&background=1e293b&color=fff&size=250" alt="Avatar">
					<% } %>
				</div>
				<h2 style="font-size: 24px; font-weight: 700; margin-bottom: 5px;"><%= user.username %></h2>
				<p style="color: var(--dash-text-muted); font-size: 14px;"><%= user.email %></p>
				<p style="margin-top: 10px; font-size: 13px; color: var(--dash-text-muted);">Joined: <%= new Date(user.createdAt || Date.now()).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) %></p>
				
				<form id="profilePicForm" action="/profile/edit" method="POST" enctype="multipart/form-data">
					<input type="file" id="profileUpload" name="profilePicture" accept="image/*" style="display: none;" onchange="document.getElementById('profilePicForm').submit();">
					<label for="profileUpload" class="btn-outline" style="cursor: pointer; display: inline-block;">Update Picture</label>
				</form>
			</div>

			<!-- Recent Activity -->
			<div class="glass-card animate-in delay-3" style="padding: 30px;">
				<h3 style="font-size: 18px; font-weight: 700; margin-bottom: 10px;">Recent Activity</h3>
				<ul class="activity-list">
					<li class="activity-item">
						<div class="activity-icon">🏆</div>
						<div>
							<p style="font-size: 14px; font-weight: 600;">Completed Daily Quiz</p>
							<p style="font-size: 12px; color: var(--dash-text-muted);">2 hours ago</p>
						</div>
					</li>
					<li class="activity-item">
						<div class="activity-icon">📚</div>
						<div>
							<p style="font-size: 14px; font-weight: 600;">Finished Module 3</p>
							<p style="font-size: 12px; color: var(--dash-text-muted);">Yesterday</p>
						</div>
					</li>
					<li class="activity-item">
						<div class="activity-icon">🎯</div>
						<div>
							<p style="font-size: 14px; font-weight: 600;">Enrolled in Web Dev</p>
							<p style="font-size: 12px; color: var(--dash-text-muted);">3 days ago</p>
						</div>
					</li>
				</ul>
			</div>

		</aside>

	</div>

</body>
</html>
